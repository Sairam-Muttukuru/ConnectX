# ==========================================
# Root .gitignore for ConnectX Monorepo
# ==========================================

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo

# ==========================================
# Frontend (React / Vite)
# ==========================================
**/node_modules/
**/dist/
**/dist-ssr/
**/build/
**/coverage/
.eslintcache
.stylelintcache

# Frontend Environment Variables & Secrets
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/*.env.local

# Logs
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Backend (Java / Spring Boot / Maven)
# ==========================================
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Maven release and wrappers
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Eclipse & NetBeans
.apt_generated
.apt_generated_tests
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
nbproject/private/
nbbuild/

# Backend Local configuration & secrets
**/application-local.properties
**/application-dev.local.properties
**/application-secret.properties
**/application-*.local.properties

# AI / Tooling cache
.ai/
